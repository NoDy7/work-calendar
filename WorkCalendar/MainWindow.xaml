<Window x:Class="WorkCalendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рабочий календарь"
        Icon="icon.ico"
        Height="820" Width="1180" MinHeight="640" MinWidth="960"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="📅 Рабочий календарь"
                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PrevBtn" Content="◀" Padding="12,6"/>
                <TextBlock x:Name="MonthLabel" FontSize="18" FontWeight="SemiBold"
                           Width="200" TextAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="NextBtn" Content="▶" Padding="12,6"/>
                <Button x:Name="TodayBtn" Content="Сегодня" Margin="10,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="SettingsBtn" Content="⚙ Настройки"/>
                <Button x:Name="ExportBtn" Content="⬇ Экспорт" Margin="8,0,0,0"/>
                <Button x:Name="ImportBtn" Content="⬆ Импорт" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" x:Name="WeekHeader" Columns="7" Margin="0,0,0,6"/>
                    <UniformGrid Grid.Row="1" x:Name="DayGrid" Columns="7" Rows="6"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="14" Padding="16" Margin="16,0,0,0">
                <StackPanel>
                    <TextBlock Text="Итоги месяца" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <StackPanel x:Name="SummaryPanel"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="2,12,0,0" Foreground="{StaticResource Muted}" FontSize="12"
                   Text="Кликни по дню — отметь смену, ставку и расходы. Данные хранятся локально в файле data.json."/>
    </Grid>
</Window>
