<Window x:Class="WorkCalendar.DayEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="День"
        Icon="icon.ico"
        Width="540" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}">

    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>

        <CheckBox x:Name="WorkedChk" Content="Работал в этот день" Margin="0,0,0,14"/>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Режим оплаты" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="HourlyRb" Content="За час" GroupName="mode" IsChecked="True"/>
                    <RadioButton x:Name="ShiftRb" Content="За смену" GroupName="mode" Margin="16,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="RateLabel" Text="Ставка, за час" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                <TextBox x:Name="RateBox"/>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="HourlyPanel">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Начало" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="StartBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Конец" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="EndBox"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Часов" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="HoursBox"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <TextBlock Text="Расходы за день" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
        <StackPanel x:Name="ExpPanel"/>
        <Button x:Name="AddExpBtn" Content="+ Добавить расход" HorizontalAlignment="Left" Margin="0,4,0,0"/>

        <TextBlock Text="Заметка" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,6"/>
        <TextBox x:Name="NoteBox" AcceptsReturn="True" Height="56" TextWrapping="Wrap"/>

        <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,14,0,0">
            <StackPanel>
                <DockPanel Margin="0,2,0,2">
                    <TextBlock Text="Заработано" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="EarnText" Foreground="{StaticResource Green}" HorizontalAlignment="Right"/>
                </DockPanel>
                <DockPanel Margin="0,2,0,2">
                    <TextBlock Text="Расходы" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="SpendText" Foreground="{StaticResource Red}" HorizontalAlignment="Right"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Итог за день" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NetText" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DeleteBtn" Content="Удалить"/>
            <Button x:Name="CancelBtn" Content="Отмена" Margin="8,0,0,0"/>
            <Button x:Name="SaveBtn" Content="Сохранить" Margin="8,0,0,0"
                    Background="{StaticResource Accent}" Foreground="{StaticResource Dark}" FontWeight="SemiBold"/>
        </StackPanel>
    </StackPanel>
</Window>
